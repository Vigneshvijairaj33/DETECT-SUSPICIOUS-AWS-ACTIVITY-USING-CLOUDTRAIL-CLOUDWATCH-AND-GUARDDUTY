# ============================================================
# .env.example — Copy this to .env and fill in your values.
# NEVER commit the real .env file.
# ============================================================

# AWS Region (e.g. us-east-1, ap-south-1)
AWS_DEFAULT_REGION=us-east-1

# AWS CLI named profile (set up via `aws configure --profile <name>`)
# Leave as "default" if you only have one profile.
AWS_PROFILE=default

# Notification email — receives CloudWatch alarm and GuardDuty alerts
ALERT_EMAIL=your-email@example.com

# Project-wide resource name prefix (keep it short, lowercase, no spaces)
PROJECT_PREFIX=suspicious-activity

# SNS Topic name (will be created in Phase 4)
SNS_TOPIC_NAME=security-alerts

# CloudTrail trail name (will be created in Phase 2)
CLOUDTRAIL_TRAIL_NAME=security-monitoring-trail

# S3 bucket for CloudTrail logs
# Must be globally unique — append your account ID or random suffix
CLOUDTRAIL_BUCKET_NAME=cloudtrail-logs-ACCOUNT_ID-REGION

# CloudWatch log group name (will be created in Phase 3)
CLOUDWATCH_LOG_GROUP=/aws/cloudtrail/security-monitoring

# GuardDuty detector ID (will be filled after enabling GuardDuty in Phase 5)
GUARDDUTY_DETECTOR_ID=

# Dashboard port (local Streamlit dashboard)
DASHBOARD_PORT=8501
